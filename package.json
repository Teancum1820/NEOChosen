{
  "name": "neochosen-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static NEO Chosen event website for Cloudflare Pages.",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "check:sponsorships": "node scripts/check-sponsorship-pages.mjs",
    "check:site-chrome": "node scripts/check-site-chrome.mjs",
    "check:local-links": "node scripts/check-local-links.mjs",
    "check:events": "node scripts/check-event-pages.mjs",
    "check:sponsors": "node scripts/check-sponsor-system.mjs",
    "check:raffle": "node scripts/check-raffle-coming-soon.mjs",
    "test:raffle-functions": "node scripts/test-raffle-functions.mjs",
    "storybook": "npm run build && storybook dev -p 6006 --no-open",
    "build-storybook": "npm run build && storybook build -o artifacts/storybook",
    "test:e2e": "npm run build && playwright test --project=functional",
    "test:a11y": "npm run build && playwright test --project=accessibility",
    "test:visual": "npm run build && playwright test --project=visual",
    "test:visual:update": "npm run build && playwright test --project=visual --update-snapshots",
    "screenshots": "npm run build && node scripts/run-screenshots.mjs",
    "screenshots:review": "npm run build && node scripts/capture-implementation.mjs",
    "lighthouse": "npm run build && lhci collect && lhci assert",
    "images:audit": "node scripts/audit-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.tooling.json",
    "test": "npm run build && npm run check:sponsorships && npm run check:site-chrome && npm run check:local-links && npm run check:events && npm run check:sponsors && npm run check:raffle && npm run test:raffle-functions",
    "format:check": "prettier --check .storybook stories design-system tests/browser playwright.config.mjs lighthouserc.json eslint.config.mjs tsconfig.tooling.json",
    "dev": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler deploy --config production/wrangler.jsonc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/html-vite": "^10.6.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "lucide-react": "^1.33.0",
    "prettier": "^3.9.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "storybook": "^10.6.1",
    "typescript": "^7.0.2",
    "wrangler": "4.123.0"
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neochosen",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "RAFFLE_DB",
      "database_name": "neochosen-raffle",
      "database_id": "bd1712c6-7ec2-4b3a-be0b-ef525d4c99c2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAFFLE_UPLOADS",
      "bucket_name": "neochosen-raffle-uploads"
    }
  ]
}
